<html data-zui-theme="holo">
<link rel="stylesheet" href="zui/css/zui.css" />
<link rel="stylesheet" href="zui/css/themes/holo.css" />
<script src="zui/icons/sprite.js"></script>
<script src="zui/js/zui.js"></script>
<body>
    <panel class="flush">
        <col class="gap-4 align-center justify-center p-8" style="height: 100%;">
            <row class="gap-4 align-center">
                <img src="icon.png" width="64" height="64" />
                <col class="gap-2">
                    <text class="fs-20 bold">zShot</text>
                    <text class="fs-13">Build 20</text>
                </col>
            </row>
            <button export="ok" class="mt-4">OK</button>
        </col>
    </panel>
</body>
</html>
