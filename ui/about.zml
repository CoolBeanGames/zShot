<html data-zui-theme="holo">
<link rel="stylesheet" href="zui/css/zui.css" />
<link rel="stylesheet" href="zui/css/themes/holo.css" />
<script src="zui/icons/sprite.js"></script>
<script src="zui/js/zui.js"></script>
<body>
    <panel class="fill pad-16">
        <col class="gap-16">
            <row class="gap-16">
                <!-- App icon - just an image of ZS-4.png or the icon.png -->
                <img src="../icon.png" width="64" height="64" />
                <col class="gap-4">
                    <text class="fs-20 bold">zShot</text>
                    <text class="fs-13">Build 9</text>
                </col>
            </row>
            <row class="gap-8 right">
                <button id="ok-btn" export="ok">OK</button>
            </row>
        </col>
    </panel>
    <script>
        zui.receive("ok", function() {
            zui.send("close-about", {});
        });
    </script>
</body>
</html>
